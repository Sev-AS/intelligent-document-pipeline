{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Daily Document Pipeline Summary",
      "weight": "Bolder",
      "size": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Automated triage metrics for ${report_date}",
      "isSubtle": true,
      "spacing": "None"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Total Documents Processed", "value": "${total_processed}" },
        { "title": "Auto-Routed to SharePoint", "value": "${auto_routed}" },
        { "title": "Escalated to Teams", "value": "${escalated}" },
        { "title": "Pending Human Review", "value": "${pending_review}" },
        { "title": "Failed / DLQ", "value": "${failed_count}" }
      ]
    }
  ]
}
